MILO_NEO4J_URI=bolt://localhost:7688
MILO_NEO4J_USER=neo4j
MILO_NEO4J_PASSWORD=choose-a-password

# Where finished sim bundles land on this PC (the same folder the MILO MCP scripts target).
MILO_DROP_DIR=C:\milo_drop

# The same folder as the BIOVIA VM sees it: the MCP writes it into every script.
MILO_DROP_DIR_VM=C:\milo_drop

# The BIOVIA documentation dumps the MCP searches (milo_search_docs).
MILO_DOCS_DIR=C:\Users\jroma\Documents\biovia

# Seconds between looks at the drop folder.
MILO_SCAN_SECONDS=3

# Calculated ghosts per real run, for each knob: each is that run with one knob moved (ghost.md 4.3).
MILO_GHOSTS=1
